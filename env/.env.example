# Copy to env/.env.dev or override locally with .env (gitignored).
# Shell variables win over both files. .env wins over the selected env file.
# Do not commit real passwords.

TEST_ENV=dev
BASE_URL=https://example.com
API_BASE_URL=https://example.com

ACTION_TIMEOUT=15000
NAVIGATION_TIMEOUT=30000
EXPECT_TIMEOUT=10000

LOCALE=en-US
TIMEZONE=Asia/Kolkata

# Comma-separated: chromium, firefox, webkit, mobile-chrome
BROWSERS=chromium
# HEADLESS=false
